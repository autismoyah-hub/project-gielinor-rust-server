new file mode 100644
index 0000000..5c91935
--- /dev/null
+++ b/examples/tower_actions.rs
@@ -0,0 +1,29 @@
+//! Headless use of the same normal-action adapter as native live-view.
+//! CACHE ADDRESS USER PASSWORD_FILE PUBLIC_KEY; TOWER_ACTION_DIRECTORY required.
+use gielinor_client::{
+    client_state::ClientState, disk_cache::DiskCache, live_runtime::Connection,
+    tower_adapter::Adapter,
+};
+use std::time::{Duration, Instant};
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<_> = std::env::args().collect();
+    if args.len() != 6 {
+        return Err("expected CACHE ADDRESS USER PASSWORD_FILE PUBLIC_KEY".into());
+    }
+    let mut adapter = Adapter::from_env()?.ok_or("TOWER_ACTION_DIRECTORY required")?;
+    let mut client = ClientState::load(DiskCache::open(&args[1], 64 << 20)?)?;
+    let mut live = Connection::connect(&mut client, &args[2], &args[3], &args[4], &args[5])?;
+    let start = Instant::now();
+    while start.elapsed() < Duration::from_secs(1800) {
+        live.poll(&mut client)?;
+        let ready = live.world.is_some() && live.title.is_none() && !live.is_reconnecting();
+        adapter.poll(&mut client, ready)?;
+        if adapter.stop {
+            live.session.close();
+            return Ok(());
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    live.session.close();
+    Err("headless validation timed out".into())
+}
